---
import Contactform from "@/components/contactform.astro";
import Container from "@/components/container.astro";
import Sectionhead from "@/components/sectionhead.astro";
import Layout from "@/layouts/Layout.astro";
import { SITE } from "@/utils/constants.js";
import { Icon } from "astro-icon/components";
---

<Layout title="Контакты | Экспресс-Наладная">
  <Container>
    <div class="py-12 md:py-16">
      <Sectionhead>
        <Fragment slot="title">Контакты</Fragment>
        <Fragment slot="desc">Мы на связи и готовы помочь с настройкой, активацией и использованием программы.</Fragment>
      </Sectionhead>

      <div class="grid md:grid-cols-2 gap-10 mx-auto max-w-4xl mt-12">
        <div class="space-y-6">
          <div class="rounded-xl border border-zinc-200 bg-white dark:border-zinc-800 dark:bg-zinc-900/50 p-6 md:p-8 shadow-sm">
            <h2 class="font-semibold text-xl text-zinc-900 dark:text-zinc-100">Служба поддержки</h2>
            <p class="text-sm leading-relaxed text-zinc-600 dark:text-zinc-400 mt-2">
              Возникли вопросы по лицензированию, печати накладных или работе с программой? Напишите нам удобным способом.
            </p>

            <div class="mt-6 space-y-4">
              <!-- Telegram Bot -->
              <a
                href="https://t.me/ExpressNakladnayaBot"
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center gap-3.5 p-3.5 rounded-lg border border-zinc-200 dark:border-zinc-800 hover:border-zinc-300 dark:hover:border-zinc-700 bg-zinc-50 dark:bg-zinc-950/50 transition-colors group">
                <div class="flex items-center justify-center w-10 h-10 rounded-full bg-sky-500/10 text-sky-600 dark:text-sky-400 shrink-0">
                  <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M12 2a10 10 0 1 0 10 10A10 10 0 0 0 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69.01-.03.01-.14-.07-.2-.08-.06-.19-.04-.27 0-.12.05-1.98 1.26-5.58 3.7-.53.36-1.01.54-1.44.53-.47-.01-1.38-.27-2.06-.49-.83-.27-1.49-.42-1.43-.88.03-.24.37-.49 1.02-.75 3.98-1.73 6.64-2.87 7.98-3.44 3.8-1.6 4.59-1.88 5.1-1.89.11 0 .37.03.54.17.14.12.18.28.2.45-.02.07-.02.13-.04.22z"/>
                  </svg>
                </div>
                <div>
                  <div class="text-xs font-medium text-zinc-500 dark:text-zinc-400">Telegram-бот (рекомендуется)</div>
                  <div class="text-sm font-semibold text-zinc-900 dark:text-zinc-100 group-hover:underline">@ExpressNakladnayaBot</div>
                </div>
              </a>

              <!-- Email -->
              <a
                href="mailto:contact@express-nakladnaya.ru"
                class="flex items-center gap-3.5 p-3.5 rounded-lg border border-zinc-200 dark:border-zinc-800 hover:border-zinc-300 dark:hover:border-zinc-700 bg-zinc-50 dark:bg-zinc-950/50 transition-colors group">
                <div class="flex items-center justify-center w-10 h-10 rounded-full bg-zinc-500/10 text-zinc-700 dark:text-zinc-300 shrink-0">
                  <Icon class="w-5 h-5" name="uil:envelope" />
                </div>
                <div>
                  <div class="text-xs font-medium text-zinc-500 dark:text-zinc-400">Электронная почта</div>
                  <div class="text-sm font-semibold text-zinc-900 dark:text-zinc-100 group-hover:underline">contact@express-nakladnaya.ru</div>
                </div>
              </a>
            </div>

            <div class="mt-6 pt-6 border-t border-zinc-200 dark:border-zinc-800 text-xs text-zinc-500 space-y-1.5">
              <p>✓ Время работы поддержки: пн-пт с 10:00 до 18:00 по МСК.</p>
              <p>✓ Время ответа техподдержки — до 24 часов в рабочие дни.</p>
              <p>✓ Безопасная обработка обращений в соответствии с требованиями РФ.</p>
            </div>
          </div>
        </div>

        <div class="rounded-xl border border-zinc-200 bg-white dark:border-zinc-800 dark:bg-zinc-900/50 p-6 md:p-8 shadow-sm">
          <h2 class="font-semibold text-xl text-zinc-900 dark:text-zinc-100 mb-2">Написать нам</h2>
          <p class="text-sm text-zinc-600 dark:text-zinc-400 mb-6">
            Заполните форму ниже, и мы ответим на указанный email в течение рабочего дня.
          </p>
          <Contactform />
        </div>
      </div>
    </div>
  </Container>
</Layout>
