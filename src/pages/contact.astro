---
import Container from "@/components/container.astro";
import Sectionhead from "@/components/sectionhead.astro";
import Layout from "@/layouts/Layout.astro";
import { SITE } from "@/utils/constants.js";
import { Icon } from "astro-icon/components";
---

<Layout title="Контакты | Экспресс-Наладная">
  <Container>
    <div class="py-12 md:py-16">
      <Sectionhead>
        <Fragment slot="title">Контакты</Fragment>
        <Fragment slot="desc">Мы на связи и готовы помочь с настройкой, активацией и использованием программы.</Fragment>
      </Sectionhead>

      <div class="max-w-xl mx-auto mt-12">
        <div class="rounded-xl border border-zinc-200 bg-white dark:border-zinc-800 dark:bg-zinc-900/50 p-6 md:p-8 shadow-sm">
          <h2 class="font-semibold text-xl text-zinc-900 dark:text-zinc-100">Служба поддержки</h2>
          <p class="text-sm leading-relaxed text-zinc-600 dark:text-zinc-400 mt-2">
            Возникли вопросы по лицензированию, печати накладных или работе с программой? Напишите нам удобным способом.
          </p>

          <div class="mt-6 space-y-4">
            <!-- Телеграм-бот -->
            <a
              href="https://t.me/ExpressNakladnayaSupportBot"
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-3.5 p-3.5 rounded-lg border border-zinc-200 dark:border-zinc-800 hover:border-zinc-300 dark:hover:border-zinc-700 bg-zinc-50 dark:bg-zinc-950/50 transition-colors group">
              <div class="flex items-center justify-center w-10 h-10 rounded-full bg-sky-500/10 text-sky-600 dark:text-sky-400 shrink-0 p-2">
                <img src={`${import.meta.env.BASE_URL}icon.svg`} alt="Экспресс-Накладная" class="w-6 h-6 rounded shadow-sm" />
              </div>
              <div>
                <div class="text-xs font-medium text-zinc-500 dark:text-zinc-400">Телеграм-бот (рекомендуется)</div>
                <div class="text-sm font-semibold text-zinc-900 dark:text-zinc-100 group-hover:underline">@ExpressNakladnayaSupportBot</div>
              </div>
            </a>

            <!-- Email -->
            <a
              href="mailto:contact@express-nakladnaya.ru"
              class="flex items-center gap-3.5 p-3.5 rounded-lg border border-zinc-200 dark:border-zinc-800 hover:border-zinc-300 dark:hover:border-zinc-700 bg-zinc-50 dark:bg-zinc-950/50 transition-colors group">
              <div class="flex items-center justify-center w-10 h-10 rounded-full bg-zinc-500/10 text-zinc-700 dark:text-zinc-300 shrink-0">
                <Icon class="w-5 h-5" name="uil:envelope" />
              </div>
              <div>
                <div class="text-xs font-medium text-zinc-500 dark:text-zinc-400">Электронная почта</div>
                <div class="text-sm font-semibold text-zinc-900 dark:text-zinc-100 group-hover:underline">contact@express-nakladnaya.ru</div>
              </div>
            </a>
          </div>

          <div class="mt-6 pt-6 border-t border-zinc-200 dark:border-zinc-800 text-xs text-zinc-500 space-y-1.5">
            <p>✓ Время работы поддержки: пн-пт с 10:00 до 18:00 по МСК.</p>
            <p>✓ Время ответа техподдержки — до 24 часов в рабочие дни.</p>
            <p>✓ Безопасная обработка обращений в соответствии с требованиями РФ.</p>
          </div>
        </div>
      </div>
    </div>
  </Container>
</Layout>
