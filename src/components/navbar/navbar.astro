---
import Container from "@/components/container.astro";
import { Astronav, MenuItems, MenuIcon } from "astro-navbar";
import { SITE } from "@/utils/constants.js";

const menuitems = [
  { title: "Возможности", path: "/#features" },
  { title: "Цены", path: "/pricing" },
  { title: "Купить", path: "/buy" },
];
---

<header class="sticky top-0 z-50 bg-white/90 dark:bg-zinc-950/90 backdrop-blur-md border-b border-zinc-200 dark:border-zinc-800/80 transition-colors">
  <Container>
    <nav class="flex flex-col lg:flex-row justify-between items-center py-4">
      <Astronav>
        <div class="flex w-full lg:w-auto items-center justify-between">
          <div class="flex items-center gap-2">
            <a href="/" class="flex items-center gap-2 group">
              <span class="font-bold text-zinc-900 dark:text-zinc-100 tracking-tight text-lg">{SITE.name}</span>
            </a>
            <a href="/versions" title="Архив версий" class="text-xs px-2 py-0.5 rounded bg-zinc-100 text-zinc-700 border border-zinc-200 dark:bg-zinc-800 dark:text-zinc-400 dark:border-zinc-700/50 hover:border-zinc-400 dark:hover:border-zinc-500 transition-colors">
              {SITE.version}
            </a>
          </div>
          <div class="flex items-center gap-2 lg:hidden">
            <button
              id="theme-toggle-mobile"
              aria-label="Переключить тему"
              class="p-2 rounded-md text-zinc-700 hover:text-zinc-900 hover:bg-zinc-100 dark:text-zinc-300 dark:hover:text-zinc-100 dark:hover:bg-zinc-900 transition-colors">
              <svg class="w-5 h-5 hidden dark:block" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m3.343-5.657l-.707-.707m12.728 12.728l-.707-.707m0-11.314l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path>
              </svg>
              <svg class="w-5 h-5 block dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path>
              </svg>
            </button>
            <div class="block lg:hidden">
              <MenuIcon class="w-5 h-5 text-zinc-700 dark:text-zinc-300" />
            </div>
          </div>
        </div>
        <MenuItems class="hidden w-full lg:w-auto mt-3 lg:flex lg:mt-0">
          <ul class="flex flex-col lg:flex-row lg:gap-1 items-center">
            {
              menuitems.map((item) => (
                <li>
                  <a
                    href={item.path}
                    class="flex lg:px-3 py-1.5 text-sm text-zinc-600 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-100 transition-colors rounded-md hover:bg-zinc-100 dark:hover:bg-zinc-900">
                    {item.title}
                  </a>
                </li>
              ))
            }
          </ul>
          <div class="lg:hidden flex flex-col mt-4 gap-2 pt-3 border-t border-zinc-200 dark:border-zinc-800">
            <a
              href={SITE.downloadUrl}
              class="inline-flex items-center justify-center px-4 py-2 text-sm font-medium text-white bg-zinc-900 hover:bg-zinc-800 dark:text-zinc-950 dark:bg-zinc-100 dark:hover:bg-white rounded-md transition-colors text-center shadow-sm">
              Скачать .exe
            </a>
          </div>
        </MenuItems>
      </Astronav>
      <div class="hidden lg:flex items-center gap-3">
        <button
          id="theme-toggle"
          aria-label="Переключить тему"
          class="p-2 rounded-md text-zinc-700 hover:text-zinc-900 hover:bg-zinc-100 dark:text-zinc-300 dark:hover:text-zinc-100 dark:hover:bg-zinc-900 transition-colors"
          title="Сменить тему">
          <svg class="w-5 h-5 hidden dark:block" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m3.343-5.657l-.707-.707m12.728 12.728l-.707-.707m0-11.314l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path>
          </svg>
          <svg class="w-5 h-5 block dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path>
          </svg>
        </button>
        <a
          href={SITE.downloadUrl}
          class="inline-flex items-center justify-center px-4 py-1.5 text-sm font-medium text-white bg-zinc-900 hover:bg-zinc-800 dark:text-zinc-950 dark:bg-zinc-100 dark:hover:bg-white rounded-md transition-colors shadow-sm">
          Скачать .exe
        </a>
      </div>
    </nav>
  </Container>
</header>

<script>
  function setupThemeToggle() {
    const toggles = [document.getElementById('theme-toggle'), document.getElementById('theme-toggle-mobile')];
    toggles.forEach((btn) => {
      if (btn && !btn.dataset.bound) {
        btn.dataset.bound = 'true';
        btn.addEventListener('click', () => {
          if (document.documentElement.classList.contains('dark')) {
            document.documentElement.classList.remove('dark');
            localStorage.setItem('theme', 'light');
          } else {
            document.documentElement.classList.add('dark');
            localStorage.setItem('theme', 'dark');
          }
        });
      }
    });
  }

  setupThemeToggle();
  document.addEventListener('astro:after-swap', setupThemeToggle);
</script>
