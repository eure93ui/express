---
const features = [
  {
    title: "Работает без интернета",
    description: "База данных хранится на вашем компьютере. Пропал интернет или отключили свет в торговом центре? Программа продолжает работать без сбоев.",
    svgPath: "M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4",
  },
  {
    title: "Печать за 30 секунд",
    description: "Никаких сложных справочников и лишних окон. Добавили товар, нажали печать — накладная, товарный чек или ценник готовы.",
    svgPath: "M13 10V3L4 14h7v7l9-11h-7z",
  },
  {
    title: "Разовая покупка навсегда",
    description: "Никаких ежемесячных подписок. Покупаете один раз, пользуетесь сколько угодно. Все обновления внутри версии бесплатны.",
    svgPath: "M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z",
  },
  {
    title: "Защита от споров и ошибок",
    description: "Вся история продаж сохраняется локально. Быстрый возврат, учет остатков и строгая отчетность для ИП без бухгалтеров.",
    svgPath: "M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z",
  },
];
---

<section id="features" class="py-20 md:py-28 border-b border-zinc-200 dark:border-zinc-800/80 transition-colors">
  <div class="max-w-6xl mx-auto px-5">
    <div class="text-center max-w-2xl mx-auto mb-16">
      <h2 class="text-xs uppercase tracking-widest text-zinc-500 font-mono mb-3">Возможности</h2>
      <h3 class="text-3xl sm:text-4xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100">
        Создано для реальной торговли в рознице
      </h3>
      <p class="mt-4 text-zinc-600 dark:text-zinc-400">
        Всё, что нужно микробизнесу для быстрой выдачи документов покупателям, без громоздких 1С и облачных касс.
      </p>
    </div>

    <div class="grid md:grid-cols-2 gap-6">
      {
        features.map((item) => (
          <div class="p-8 rounded-xl border border-zinc-200 bg-white shadow-sm hover:border-zinc-300 dark:border-zinc-800 dark:bg-zinc-900/40 dark:hover:border-zinc-700 transition-all flex flex-col justify-between">
            <div>
              <div class="w-10 h-10 rounded-lg bg-zinc-100 border border-zinc-200 flex items-center justify-center mb-6 text-zinc-800 dark:bg-zinc-800 dark:border-zinc-700 dark:text-zinc-200">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={item.svgPath}></path></svg>
              </div>
              <h4 class="text-xl font-bold text-zinc-900 dark:text-zinc-100 mb-2">{item.title}</h4>
              <p class="text-zinc-600 dark:text-zinc-400 text-sm leading-relaxed">{item.description}</p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
